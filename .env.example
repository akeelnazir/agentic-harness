SERPAPI_KEY=
TWELVEDATA_API_HOST=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

LLM_PROVIDER=lmstudio

OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

OPENROUTER_API_KEY=

