MAX_MESSAGES_TO_KEEP=20

# MCP (Model Context Protocol) Servers Configuration
# Format: JSON object with server names as keys
# Example with filesystem server via stdio:
# MCP_SERVERS='{"filesystem":{"type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/path/to/allowed/dir"]}}'
# Example with fetch server via SSE:
# MCP_SERVERS='{"fetch":{"type":"sse","url":"http://localhost:3001/sse"}}'
MCP_SERVERS=
